# ---- 构建产物 ----
build/
dist/
*.spec
!YouBoard.spec
!YouBoard_Mac.spec
*.manifest.disabled

# ---- Python ----
__pycache__/
*.pyc
*.pyo

# ---- YouBoard 运行时数据（包含个人剪贴板历史，切勿提交到公开仓库！）----
.youboard.json
.youboard.json.bak
.youboard_snapshots.json
youboard_config.json
images/
# 运行时缓存：设了密库主密码后，解锁期间解密出来的图片副本会落在这里
file_cache/
# 密库（3.3.1）：用户主动存放的私密内容，绝对不能进公开仓库
youboard_vault.json
youboard_vault.json.bak
vault_files/
# 本地加密密钥 / 运行日志
youboard.key
youboard_error.log

# ---- 可执行文件（通过 GitHub Releases 分发，不进仓库）----
*.exe

# ---- 浏览器扩展的打包产物（上架时本地生成，不进仓库）----
edge_extension/*.zip

# ---- IDE / 工具 ----
.qoder/
.claude.json

# ---- 私密素材（仅本地保留，禁止提交）----
res/no use/
res/*.psd
